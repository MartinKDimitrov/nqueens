#!/usr/bin/env bash
# Everything a commit has to pass, run before it is made rather than after.
#
# Install into a project with:
#
#     mkdir -p .githooks && cp ~/.claude/templates/pre-commit .githooks/
#     chmod +x .githooks/pre-commit
#     git config core.hooksPath .githooks
#
# The reason this is a hook and not a habit: in practice every round of fixes
# introduces a defect, and the ones that do real damage are caught by checks
# that had been run -- just not before the commit that buried them. The hook
# removes the step where a human decides whether this change is worth checking.
#
# To skip it you have to say so out loud:
#
#     git commit --no-verify
#
# which is a decision with a name, and that is the point.
set -euo pipefail

# --- one entry point called "check" ----------------------------------------
#
# The project must define a single command meaning "everything a commit must
# pass": lint, type check, tests, and whatever else CI runs. One name, so this
# hook and CI and a person at a keyboard all run the same thing.

run_check() {
    if [ -f Makefile ] && grep -qE '^check:' Makefile; then
        make check
    elif [ -f justfile ] && grep -qE '^check:' justfile; then
        just check
    elif [ -f package.json ] && grep -q '"check"' package.json; then
        if [ -f pnpm-lock.yaml ];   then pnpm run check
        elif [ -f yarn.lock ];      then yarn check
        else                             npm run check
        fi
    elif [ -f gradlew ]; then
        ./gradlew check
    elif [ -f Cargo.toml ]; then
        cargo clippy -- -D warnings && cargo test
    else
        cat >&2 <<'MSG'

pre-commit: this project has no `check` command.

  Define one -- a Makefile target, a just recipe, an npm script -- that runs
  everything a commit must pass: formatter, linter, type checker, tests, and
  whatever else CI runs. One name, so that this hook, CI, and a person at a
  keyboard all run the same thing and cannot drift apart.

MSG
        exit 1
    fi
}

run_check

# `check` must itself exercise the project's real fixtures -- the corpus,
# golden files or recorded samples -- and not only inputs invented alongside
# the code. That belongs inside the `check` command rather than here, because
# this hook cannot tell what a test actually read.

# Documentation enforcement was removed for this project: the gate runs `check` only.
