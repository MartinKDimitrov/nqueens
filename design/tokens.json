{
  "$schema": "https://example.com/nqueens-design-tokens",
  "name": "N-Queens Puzzle Design Tokens",
  "version": "1.0.0",
  "colors": {
    "light": {
      "background": "#F4F6F8",
      "surface": "#FFFFFF",
      "surfaceAlt": "#E9EDF2",
      "border": "#D5DBE3",
      "onSurface": "#101A22",
      "onSurfaceMuted": "#5C6B7A",
      "primary": "#0E7C86",
      "onPrimary": "#FFFFFF",
      "boardLight": "#E6EAEF",
      "boardDark": "#B9C2CE",
      "queen": "#12212B",
      "queenOn": "#FFFFFF",
      "conflict": "#D93A3A",
      "conflictGlow": "#F7C9C9",
      "blocked": "#97A2AE",
      "fixed": "#4A5A69",
      "hint": "#54C3CB",
      "success": "#1F9D6B"
    },
    "dark": {
      "background": "#0B1116",
      "surface": "#131C23",
      "surfaceAlt": "#1B262F",
      "border": "#2A3742",
      "onSurface": "#EAF1F5",
      "onSurfaceMuted": "#93A4B1",
      "primary": "#29B9AE",
      "onPrimary": "#04211F",
      "boardLight": "#2C3A45",
      "boardDark": "#1A252E",
      "queen": "#EAF1F5",
      "queenOn": "#0B1116",
      "conflict": "#FF6B6B",
      "conflictGlow": "#4A1E22",
      "blocked": "#55636F",
      "fixed": "#8FA1AE",
      "hint": "#2FBFC8",
      "success": "#46D39A"
    }
  },
  "typography": {
    "fontFamily": "Inter, \"Roboto\", system-ui, sans-serif",
    "monoFamily": "\"JetBrains Mono\", \"Roboto Mono\", monospace",
    "scale": {
      "h1": {
        "size": 34,
        "weight": 700,
        "lineHeight": 40,
        "letterSpacing": -0.5
      },
      "h2": {
        "size": 24,
        "weight": 700,
        "lineHeight": 30,
        "letterSpacing": -0.25
      },
      "h3": {
        "size": 18,
        "weight": 600,
        "lineHeight": 24,
        "letterSpacing": 0
      },
      "body": {
        "size": 16,
        "weight": 400,
        "lineHeight": 24,
        "letterSpacing": 0
      },
      "label": {
        "size": 14,
        "weight": 600,
        "lineHeight": 20,
        "letterSpacing": 0.2
      },
      "caption": {
        "size": 12,
        "weight": 500,
        "lineHeight": 16,
        "letterSpacing": 0.4
      }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32
  },
  "radii": {
    "sm": 6,
    "md": 12
  },
  "elevation": {
    "low": 2,
    "high": 12
  }
}
